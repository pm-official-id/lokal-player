+/// The full player's design style — ArchiveTune's "Player design style"
+/// (Appearance → Player) on Lokal's own screens: the modern Lokal player,
+/// the classic layout, or edge-to-edge artwork, which used to be the
+/// Fullscreen cover toggle.
+enum LokalPlayerDesignStyle {
+  lokal('Lokal'),
+  classic('Classic'),
+  immersive('Immersive');
+
+  const LokalPlayerDesignStyle(this.label);
+
+  final String label;
+
+  static LokalPlayerDesignStyle fromKey(String? key) =>
+      LokalPlayerDesignStyle.values.firstWhere(
+        (style) => style.name == key,
+        orElse: () => LokalPlayerDesignStyle.lokal,
+      );
+}
