+/// The full player for the chosen design style: the classic layout when
+/// Classic is picked, the modern screen otherwise (Immersive is the modern
+/// screen with edge-to-edge artwork, via the appearance's fullscreenCover).
+Widget playerScreenFor(BuildContext context, Key? playerKey, String heroTag) {
+  var style = LokalPlayerDesignStyle.lokal;
+  try {
+    final container = ProviderScope.containerOf(context, listen: false);
+    style = container.read(lokalAppearanceProvider).playerDesignStyle;
+  } catch (_) {
+    // Widget tests navigate without a ProviderScope: the modern player.
+  }
+  return style == LokalPlayerDesignStyle.classic
+      ? ClassicFullPlayerScreen(heroTag: heroTag)
+      : FullPlayerScreen(key: playerKey, heroTag: heroTag);
+}
