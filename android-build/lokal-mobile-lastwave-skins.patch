diff --git a/test/core/theme/lastwave_skins_test.dart b/test/core/theme/lastwave_skins_test.dart
new file mode 100644
index 0000000..8519258
--- /dev/null
+++ b/test/core/theme/lastwave_skins_test.dart
@@ -0,0 +1,66 @@
+import 'package:flick/core/theme/lokal_tokens.dart';
+import 'package:flutter/material.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+/// The LastWave skins (Clash-Projects/LastWave-native): its signature
+/// Electric-Lime-on-Obsidian-Teal scheme, in dark and light, plus its six
+/// accent presets — ported so the pickers show them and every theme id
+/// resolves to a palette.
+void main() {
+  test('every theme id has a palette, the LastWave skins included', () {
+    expect(LokalTokens.themes.keys, containsAll(LokalThemeId.values));
+    expect(LokalThemeId.fromKey('lastwave'), LokalThemeId.lastwave);
+    expect(LokalThemeId.fromKey('lastwaveLight'), LokalThemeId.lastwaveLight);
+  });
+
+  test('the signature dark skin is electric lime on obsidian teal', () {
+    final t = LokalTokens.resolve(LokalThemeId.lastwave);
+    expect(t.accent, const Color(0xFFC9FB00));
+    expect(t.bg, const Color(0xFF01181B));
+    expect(t.surface, const Color(0xFF012226));
+    expect(t.isLight, isFalse);
+    // The lime accent is bright: content drawn on it must be dark.
+    expect(t.onAccent, const Color(0xFF0A0A0A));
+  });
+
+  test('the signature light skin keeps the brand hues readable', () {
+    final t = LokalTokens.resolve(LokalThemeId.lastwaveLight);
+    expect(t.bg, const Color(0xFFF2FBF7));
+    expect(t.text, const Color(0xFF012226));
+    expect(t.isLight, isTrue);
+    expect(t.onAccent, Colors.white);
+  });
+
+  test('the six LastWave accent presets are offered, exact values', () {
+    final names = [for (final a in LokalAccent.presets) a.name];
+    expect(names, containsAll(<String>[
+      'Crimson',
+      'Violet',
+      'Ocean',
+      'Sage',
+      'Amber',
+      'Rose',
+    ]));
+    final crimson = LokalAccent.byName('Crimson')!;
+    expect(crimson.value, const Color(0xFFE03030));
+    expect(LokalAccent.byName('Violet')!.value, const Color(0xFF7C4DFF));
+    expect(LokalAccent.byName('Ocean')!.value, const Color(0xFF2196C6));
+    expect(LokalAccent.byName('Sage')!.value, const Color(0xFF6B9E6B));
+    expect(LokalAccent.byName('Amber')!.value, const Color(0xFFE0A030));
+    expect(LokalAccent.byName('Rose')!.value, const Color(0xFFE0507A));
+  });
+
+  test('a LastWave accent overrides the signature skin and back', () {
+    final skin = LokalTokens.resolve(LokalThemeId.lastwave);
+    final redden = LokalTokens.resolve(
+      LokalThemeId.lastwave,
+      accent: LokalAccent.byName('Crimson'),
+    );
+    expect(redden.accent, const Color(0xFFE03030));
+    expect(redden.bg, skin.bg, reason: 'only the accent changes');
+    expect(LokalAccent.nearest(skin.accent).name, anyOf(<String>[
+      'Lime',
+      'Yellow',
+    ]), reason: 'the signature lime still maps to a light-hue launcher icon');
+  });
+}
