+  static LokalPlayerDesignStyle fromKey(String? key) {
+    // The first port's 'classic' was Lokal's own classic screen.
+    if (key == 'classic') return LokalPlayerDesignStyle.lokalClassic;
+    return LokalPlayerDesignStyle.values.firstWhere(
+      (style) => style.name == key,
+      orElse: () => LokalPlayerDesignStyle.lokal,
+    );
+  }
+
+  /// ArchiveTune's ten design styles, in its picker's order.
+  static const List<LokalPlayerDesignStyle> archiveStyles = [
+    atClassic,
+    atModern,
+    atMinimal,
+    atCinematic,
+    atLittle,
+    atExpressive,
+    immersive,
+    atImmersiveX,
+    atMaterialX,
+    atEditorial,
+  ];
+
+  /// Whether this screen is one of ArchiveTune's layouts.
+  bool get isArchiveStyle =>
+      this != lokal && this != lokalClassic && this != immersive;
 }
 
