+++ b/test/features/player/archive_style_spec_test.dart
@@ -0,0 +1,44 @@
+import 'package:flick/core/theme/lokal_appearance.dart';
+import 'package:flick/features/player/screens/archive_style_player_screen.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+void main() {
+  test('every ArchiveTune style has a distinct spec', () {
+    // Immersive routes to the modern screen with edge-to-edge artwork; the
+    // other nine ArchiveTune styles render through the spec table.
+    for (final style in LokalPlayerDesignStyle.archiveStyles
+        .where((s) => s != LokalPlayerDesignStyle.immersive)) {
+      final spec = ArchiveStyleSpec.specs[style];
+      expect(spec, isNotNull, reason: style.name);
+    }
+    final arts = {
+      for (final entry in ArchiveStyleSpec.specs.entries)
+        entry.key: entry.value.artScale,
+    };
+    // Little is the smallest artwork, Immersive Extended the largest.
+    expect(
+      arts[LokalPlayerDesignStyle.atLittle]!,
+      lessThan(arts[LokalPlayerDesignStyle.atClassic]!),
+    );
+    expect(
+      arts[LokalPlayerDesignStyle.atImmersiveX]!,
+      greaterThan(arts[LokalPlayerDesignStyle.atCinematic]!),
+    );
+    expect(
+      ArchiveStyleSpec.specs[LokalPlayerDesignStyle.atEditorial]!.leftAlign,
+      isTrue,
+      reason: 'Editorial sets its type to the left',
+    );
+    expect(
+      ArchiveStyleSpec.specs[LokalPlayerDesignStyle.atLittle]!.progressOnArt,
+      isTrue,
+      reason: 'Little draws its progress across the artwork',
+    );
+    expect(
+      ArchiveStyleSpec.specs[LokalPlayerDesignStyle.atImmersiveX]!
+          .whiteOnBlack,
+      isTrue,
+      reason: 'Immersive Extended plays white on black',
+    );
+  });
+}
