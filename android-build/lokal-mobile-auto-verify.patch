+++ b/lib/features/morneye/morneye_packages.dart
@@ -812,6 +812,20 @@ class MorneyePackages {
     );
   }
 
+  /// Whether a signed-session add-on was verified before and has since
+  /// lapsed: a saved session id, not just the install id that gets written
+  /// as soon as the add-on is listed. The auto-verify pass opens its sheet
+  /// only in this case — never for first-time setup or after Disconnect.
+  bool hadSession(MorneyeAddon addon) {
+    if (addon.signedSession == null) return false;
+    try {
+      return '${_sessionFor(addon, null).status()['session_id'] ?? ''}'
+          .isNotEmpty;
+    } catch (_) {
+      return false;
+    }
+  }
+
   // ------------------------------------------------------------ repositories
 
   Future<Uint8List> _document(String url, int maxBytes) async {
