From 7443118b165f86e186713cac9892063358e6c114 Mon Sep 17 00:00:00 2001
From: pm-official-id <pm-official-id@users.noreply.github.com>
Date: Sat, 24 Oct 2026 17:10:13 +0530
Subject: [PATCH] Mornye auto-verify: re-verify lapsed signed sessions on the
 phone
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Ported from desktop's electron/mornye/autoVerify.js: 12s after launch and
every 30 minutes, signed-session addons whose session existed and lapsed are
re-verified the same way the Verify button does — silently when the gateway
clears it, opening the auth sheet when it needs the person. First-time setup,
disabled addons, missing required settings and intentional logouts are left
alone. Tests in test/morneye/morneye_auto_verify_test.dart.
---
 lib/features/morneye/morneye_auto_verify.dart |  88 ++++++++++++
 lib/features/morneye/morneye_packages.dart    |  14 ++
 lib/main.dart                                 |   6 +
 test/morneye/morneye_auto_verify_test.dart    | 125 ++++++++++++++++++
 4 files changed, 233 insertions(+)
 create mode 100644 lib/features/morneye/morneye_auto_verify.dart
 create mode 100644 test/morneye/morneye_auto_verify_test.dart

diff --git a/lib/features/morneye/morneye_auto_verify.dart b/lib/features/morneye/morneye_auto_verify.dart
new file mode 100644
index 0000000..fdcad10
--- /dev/null
+++ b/lib/features/morneye/morneye_auto_verify.dart
@@ -0,0 +1,88 @@
+import 'dart:async';
+
+import 'package:flutter/foundation.dart';
+import 'package:flutter/material.dart';
+
+import '../../core/navigation/root_navigator.dart';
+import 'morneye_auth_sheet.dart';
+import 'morneye_packages.dart';
+
+/// Signed-session add-ons (Tidal, Qobuz, Deezer, Amazon…) lose their gateway
+/// session while the app is closed, and the next search or play then stops
+/// with a "verify" prompt. This pass re-verifies them on its own — at start-up
+/// and on a slow cycle — the same way the Verify button does: a challenge
+/// that clears without interaction finishes invisibly (the auth sheet's
+/// WebView keeps its cookies), and one that needs the person opens the same
+/// sheet a tap would have. Add-ons never set up, add-ons with required
+/// settings missing, and add-ons disconnected on purpose are left alone:
+/// only a session that existed and has lapsed is worth re-asking the gateway
+/// for. Ported from desktop's electron/mornye/autoVerify.js.
+
+const morneyeAutoVerifyFirstDelay = Duration(seconds: 12);
+const morneyeAutoVerifyCycle = Duration(minutes: 30);
+
+bool _running = false;
+
+/// Whether the automatic pass should re-verify [addon] now.
+bool morneyeNeedsAutoVerify(MorneyePackages packages, MorneyeAddon addon) {
+  if (!addon.enabled || addon.signedSession == null) return false;
+  final access = packages.access(addon);
+  if (access.verified || access.missing.isNotEmpty) return false;
+  return packages.hadSession(addon);
+}
+
+/// One pass over the installed add-ons, one at a time (the auth sheet is
+/// modal and sequential passes keep the gateway calm).
+Future<void> morneyeAutoVerifyPass(MorneyePackages packages) async {
+  if (_running) return;
+  _running = true;
+  try {
+    for (final addon in packages.addons) {
+      try {
+        if (!morneyeNeedsAutoVerify(packages, addon)) continue;
+        final url = await packages.verify(addon.key);
+        if (url == null || url.isEmpty) continue;
+        final context = rootNavigatorKey.currentContext;
+        if (context == null || !context.mounted) continue;
+        debugPrint('[Morneye] Auto-verifying ${addon.displayName}…');
+        final verified = await MorneyeAuthSheet.show(
+          context,
+          packages: packages,
+          addon: addon,
+          url: url,
+        );
+        debugPrint(
+          '[Morneye] Auto-verify of ${addon.displayName}: '
+          '${verified ? 'verified' : 'not completed'}',
+        );
+      } catch (error) {
+        debugPrint('[Morneye] Auto-verify of ${addon.key} failed: $error');
+      }
+    }
+  } finally {
+    _running = false;
+  }
+}
+
+/// Starts the automatic passes: once shortly after launch (after repositories
+/// have had time to refresh), then on a slow keep-alive cycle.
+void morneyeStartAutoVerify(
+  Future<MorneyePackages> packages, {
+  Duration firstDelay = morneyeAutoVerifyFirstDelay,
+  Duration cycle = morneyeAutoVerifyCycle,
+}) {
+  Timer(firstDelay, () async {
+    try {
+      await morneyeAutoVerifyPass(await packages);
+    } catch (error) {
+      debugPrint('[Morneye] Auto-verify pass failed: $error');
+    }
+    Timer.periodic(cycle, (_) async {
+      try {
+        await morneyeAutoVerifyPass(await packages);
+      } catch (error) {
+        debugPrint('[Morneye] Auto-verify pass failed: $error');
+      }
+    });
+  });
+}
diff --git a/lib/features/morneye/morneye_packages.dart b/lib/features/morneye/morneye_packages.dart
index 168f352..9fc1b2a 100644
