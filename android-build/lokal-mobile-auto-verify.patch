diff --git a/test/morneye/morneye_auto_verify_test.dart b/test/morneye/morneye_auto_verify_test.dart
new file mode 100644
index 0000000..bbe33b5
--- /dev/null
+++ b/test/morneye/morneye_auto_verify_test.dart
@@ -0,0 +1,125 @@
+import 'dart:io';
+
+import 'package:flick/features/morneye/morneye_auto_verify.dart';
+import 'package:flick/features/morneye/morneye_packages.dart';
+import 'package:flick/features/morneye/morneye_session.dart';
+import 'package:flick/features/morneye/morneye_storage.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+import 'morneye_fakes.dart';
+
+/// The automatic pass must open its sheet only for a signed-session add-on
+/// whose session existed and has lapsed: never for first-time setup, a
+/// healthy session, a turned-off add-on, missing required settings, or one
+/// disconnected on purpose. Mirrors desktop's mornye-auto-verify tests.
+void main() {
+  late Directory dir;
+  late MorneyeStorage storage;
+  late MorneyePackages packages;
+
+  final manifest = <String, Object?>{
+    'displayName': 'Tidal',
+    'signedSession': {'baseUrl': 'https://gw.example'},
+  };
+
+  MorneyeAddon addon({bool enabled = true}) => MorneyeAddon(
+        key: 'tidal-web',
+        name: 'tidal-web',
+        manifest: manifest,
+        digest: 'd1',
+        installedAt: 0,
+        methods: const [],
+        enabled: enabled,
+      );
+
+  Future<void> seedSession({
+    required bool lapsed,
+    bool authenticated = false,
+  }) async {
+    final config = (manifest['signedSession'] as Map).cast<String, Object?>();
+    final session = MorneyeSignedSession(config, storage, null, 'tidal-web');
+    final record = session.record();
+    if (lapsed || authenticated) {
+      storage.write(session.namespace, 'session', {
+        ...record,
+        'session_id': 'sid',
+        'session_secret': 'sec',
+        'expires_at': authenticated
+            ? DateTime.now()
+                .add(const Duration(hours: 1))
+                .toIso8601String()
+            : DateTime.now()
+                .subtract(const Duration(hours: 1))
+                .toIso8601String(),
+      });
+    }
+  }
+
+  setUp(() async {
+    dir = await Directory.systemTemp.createTemp('morneye-auto-verify');
+    storage = MorneyeStorage(dir, sealer: FakeNative(), vault: MemoryVault());
+    await storage.open();
+    packages = MorneyePackages(dir, storage: storage);
+  });
+
+  tearDown(() async {
+    if (dir.existsSync()) await dir.delete(recursive: true);
+  });
+
+  test('a lapsed session is the one case that re-verifies on its own', () async {
+    await seedSession(lapsed: true);
+    expect(morneyeNeedsAutoVerify(packages, addon()), isTrue);
+  });
+
+  test('a healthy session is left alone', () async {
+    await seedSession(lapsed: false, authenticated: true);
+    expect(morneyeNeedsAutoVerify(packages, addon()), isFalse);
+  });
+
+  test('first-time setup never opens the sheet by itself', () async {
+    await seedSession(lapsed: false, authenticated: false);
+    expect(morneyeNeedsAutoVerify(packages, addon()), isFalse);
+  });
+
+  test('a disconnected add-on (session cleared) is not re-verified', () async {
+    await seedSession(lapsed: true);
+    final config = (manifest['signedSession'] as Map).cast<String, Object?>();
+    MorneyeSignedSession(config, storage, null, 'tidal-web').clear();
+    expect(morneyeNeedsAutoVerify(packages, addon()), isFalse);
+  });
+
+  test('a turned-off add-on is skipped', () async {
+    await seedSession(lapsed: true);
+    expect(morneyeNeedsAutoVerify(packages, addon(enabled: false)), isFalse);
+  });
+
+  test('missing required settings or no signed session is out of scope', () async {
+    await seedSession(lapsed: true);
+    final tokenAddon = MorneyeAddon(
+      key: 'token-addon',
+      name: 'token-addon',
+      manifest: {
+        'displayName': 'Token',
+        'settings': [
+          {'key': 'token', 'label': 'Token', 'required': true, 'type': 'text'},
+        ],
+        'signedSession': {'baseUrl': 'https://gw.example'},
+      },
+      digest: 'd2',
+      installedAt: 0,
+      methods: const [],
+    );
+    expect(packages.access(tokenAddon).missing, isNotEmpty);
+    expect(morneyeNeedsAutoVerify(packages, tokenAddon), isFalse);
+
+    final plainAddon = MorneyeAddon(
+      key: 'plain',
+      name: 'plain',
+      manifest: {'displayName': 'Plain'},
+      digest: 'd3',
+      installedAt: 0,
+      methods: const [],
+    );
+    expect(morneyeNeedsAutoVerify(packages, plainAddon), isFalse);
+  });
+}
